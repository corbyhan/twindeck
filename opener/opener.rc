#include <winres.h>

// fully transparent: the Windows 11 context menu shows this next to the folder "Open" verb
1 ICON "blank.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,7,0
 PRODUCTVERSION 0,1,7,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TwinDeck folder opener"
            VALUE "FileVersion", "0.1.7.0"
            VALUE "InternalName", "TwinDeckOpen"
            VALUE "OriginalFilename", "TwinDeckOpen.exe"
            VALUE "ProductName", "TwinDeck"
            VALUE "ProductVersion", "0.1.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
