#include <winres.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
// TwinDeckOpen.exe, written next to TwinDeck.exe on install (install.cpp: kOpenerResource)
3 RCDATA "../build/TwinDeckOpen.exe"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,7,0
 PRODUCTVERSION 0,1,7,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName", "TwinDeck"
            VALUE "FileDescription", "TwinDeck - Fast file manager"
            VALUE "FileVersion", "0.1.7.0"
            VALUE "InternalName", "TwinDeck"
            VALUE "OriginalFilename", "TwinDeck.exe"
            VALUE "ProductName", "TwinDeck"
            VALUE "ProductVersion", "0.1.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END
